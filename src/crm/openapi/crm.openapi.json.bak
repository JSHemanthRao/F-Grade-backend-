  "components": {
    "schemas": {
      "CRMResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "module": { "type": "string" },
          "count": { "type": "integer" },
          "page": { "type": "integer" },
          "per_page": { "type": "integer" },
          "executionTime": { "type": "string" },
          "source": { "type": "string" },
          "data": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
        }
      },
      "CRMErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "module": { "type": "string" },
          "status": { "type": "integer" },
          "error": { "type": "string" },
          "invalidFields": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
