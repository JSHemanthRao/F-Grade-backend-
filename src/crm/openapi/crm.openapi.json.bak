{
  "openapi": "3.0.3",
  "info": {
    "title": "Zoho CRM API (Read-only)",
    "version": "1.0.0",
    "description": "Consolidated OpenAPI 3.0.3 spec for the read-only CRM endpoints and module-specific endpoints (documented as explicit paths).",
    "contact": { "name": "F-Grade" }
  },
  "servers": [
    { "url": "https://unweighted-elois-trinomially.ngrok-free.dev", "description": "Public ngrok URL" }
  ],
  "paths": {
    "/query": {
      "get": {
        "operationId": "queryCrm",
        "summary": "Query CRM (read-only)",
        "description": "Primary read-only CRM endpoint. Use query parameters to select the module and paging/filters. This endpoint only supports read operations and will return HTTP 400 for unknown modules.",
        "tags": ["CRM"],
        "parameters": [
          { "name": "module", "in": "query", "required": true, "schema": { "type": "string" }, "description": "CRM module key (e.g. leads, contacts, accounts, deals)" },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1 }, "description": "Page number" },
          { "name": "per_page", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1 }, "description": "Records per page" },
          { "name": "ids", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Comma-separated list of record ids" },
          { "name": "fields", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Comma-separated list of fields to return" },
          { "name": "filters", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Zoho criteria string" }
        ],
        "responses": {
          "200": {
            "description": "Successful CRM response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CRMResponse" }
              }
            }
          },
          "400": {
            "description": "Validation error (e.g. unknown module)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMErrorResponse" } } }
          },
          "500": {
            "description": "Server/Zoho error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMErrorResponse" } } }
          }
        }
      }
    },
    "/leads": { "get": { "operationId": "getLeads", "summary": "Get Leads", "description": "Retrieve Lead records. Uses query parameters for pagination, selection and filtering.", "tags": ["CRM"], "parameters": [ { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 }, "description": "Page number" }, { "name": "per_page", "in": "query", "schema": { "type": "integer", "minimum": 1 }, "description": "Records per page" }, { "name": "ids", "in": "query", "schema": { "type": "string" }, "description": "Comma-separated list of record ids" }, { "name": "fields", "in": "query", "schema": { "type": "string" }, "description": "Comma-separated list of fields to return" }, { "name": "filters", "in": "query", "schema": { "type": "string" }, "description": "Zoho criteria string" } ], "responses": { "200": { "description": "Successful CRM response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMResponse" } } } }, "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMErrorResponse" } } } }, "500": { "description": "Server or Zoho API error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMErrorResponse" } } } } } },
    "/contacts": { "get": { "operationId": "getContacts", "summary": "Get Contacts", "description": "Retrieve Contact records.", "tags": ["CRM"], "parameters": [ { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "per_page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "ids", "in": "query", "schema": { "type": "string" } }, { "name": "fields", "in": "query", "schema": { "type": "string" } }, { "name": "filters", "in": "query", "schema": { "type": "string" } } ], "responses": { "200": { "description": "Successful CRM response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMResponse" } } } }, "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMErrorResponse" } } } }, "500": { "description": "Server or Zoho API error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMErrorResponse" } } } } } },
    "/accounts": { "get": { "operationId": "getAccounts", "summary": "Get Accounts", "description": "Retrieve Account records.", "tags": ["CRM"], "parameters": [ { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "per_page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "ids", "in": "query", "schema": { "type": "string" } }, { "name": "fields", "in": "query", "schema": { "type": "string" } }, { "name": "filters", "in": "query", "schema": { "type": "string" } } ], "responses": { "200": { "description": "Successful CRM response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMResponse" } } } }, "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMErrorResponse" } } } }, "500": { "description": "Server or Zoho API error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMErrorResponse" } } } } } },
    "/deals": { "get": { "operationId": "getDeals", "summary": "Get Deals", "description": "Retrieve Deal records.", "tags": ["CRM"], "parameters": [ { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "per_page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "ids", "in": "query", "schema": { "type": "string" } }, { "name": "fields", "in": "query", "schema": { "type": "string" } }, { "name": "filters", "in": "query", "schema": { "type": "string" } } ], "responses": { "200": { "description": "Successful CRM response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMResponse" } } } }, "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMErrorResponse" } } } }, "500": { "description": "Server or Zoho API error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMErrorResponse" } } } } } },
    "/tasks": { "get": { "operationId": "getTasks", "summary": "Get Tasks", "description": "Retrieve Task records.", "tags": ["CRM"], "parameters": [ { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "per_page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "ids", "in": "query", "schema": { "type": "string" } }, { "name": "fields", "in": "query", "schema": { "type": "string" } }, { "name": "filters", "in": "query", "schema": { "type": "string" } } ], "responses": { "200": { "description": "Successful CRM response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMResponse" } } } }, "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMErrorResponse" } } } }, "500": { "description": "Server or Zoho API error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMErrorResponse" } } } } } },
    "/events": { "get": { "operationId": "getEvents", "summary": "Get Events", "description": "Retrieve Event records.", "tags": ["CRM"], "parameters": [ { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "per_page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "ids", "in": "query", "schema": { "type": "string" } }, { "name": "fields", "in": "query", "schema": { "type": "string" } }, { "name": "filters", "in": "query", "schema": { "type": "string" } } ], "responses": { "200": { "description": "Successful CRM response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMResponse" } } } }, "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMErrorResponse" } } } }, "500": { "description": "Server or Zoho API error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMErrorResponse" } } } } } },
