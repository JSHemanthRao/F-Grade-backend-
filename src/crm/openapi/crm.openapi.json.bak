            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "status": { "type": "string" } } },
                "examples": { "default": { "value": { "status": "ok" } } }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "operationId": "getApiHealth",
        "summary": "API Health check",
        "description": "API-level health check (same as /health) mounted under /api.",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "status": { "type": "string" } } },
                "examples": { "default": { "value": { "status": "ok" } } }
              }
            }
          }
        }
      }
    }
