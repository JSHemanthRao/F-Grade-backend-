    "/solutions": { "get": { "operationId": "getSolutions", "summary": "Get Solutions", "description": "Retrieve Solution records.", "tags": ["CRM"], "parameters": [ { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "per_page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "ids", "in": "query", "schema": { "type": "string" } }, { "name": "fields", "in": "query", "schema": { "type": "string" } }, { "name": "filters", "in": "query", "schema": { "type": "string" } } ], "responses": { "200": { "description": "Successful CRM response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMResponse" } } } }, "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMErrorResponse" } } } }, "500": { "description": "Server or Zoho API error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMErrorResponse" } } } } } },
    "/users": { "get": { "operationId": "getUsers", "summary": "Get Users", "description": "Retrieve Users (specialized Zoho users endpoint).", "tags": ["CRM"], "parameters": [ { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "per_page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "ids", "in": "query", "schema": { "type": "string" } } ], "responses": { "200": { "description": "Successful CRM response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMResponse" } } } }, "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMErrorResponse" } } } }, "500": { "description": "Server or Zoho API error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMErrorResponse" } } } } } },
    "/renewal-accounts": { "get": { "operationId": "getRenewalAccounts", "summary": "Get Renewal Accounts", "description": "Retrieve Renewal Account records.", "tags": ["CRM"], "parameters": [ { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "per_page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "ids", "in": "query", "schema": { "type": "string" } }, { "name": "fields", "in": "query", "schema": { "type": "string" } }, { "name": "filters", "in": "query", "schema": { "type": "string" } } ], "responses": { "200": { "description": "Successful CRM response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMResponse" } } } }, "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMErrorResponse" } } } }, "500": { "description": "Server or Zoho API error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMErrorResponse" } } } } } },
    "/org": { "get": { "operationId": "getOrganization", "summary": "Get Organization", "description": "Retrieve Organization information.", "tags": ["CRM"], "parameters": [ { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "per_page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "ids", "in": "query", "schema": { "type": "string" } }, { "name": "fields", "in": "query", "schema": { "type": "string" } } ], "responses": { "200": { "description": "Successful CRM response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMResponse" } } } }, "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMErrorResponse" } } } }, "500": { "description": "Server or Zoho API error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CRMErrorResponse" } } } } } },
    "/health": { "get": { "operationId": "getHealth", "summary": "Health check", "description": "Service health check endpoint.", "tags": ["Health"], "responses": { "200": { "description": "Service is healthy", "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "string" } } }, "examples": { "default": { "value": { "status": "ok" } } } } } } } } },
    "/api/health": { "get": { "operationId": "getApiHealth", "summary": "API Health check", "description": "API-level health check (same as /health) mounted under /api.", "tags": ["Health"], "responses": { "200": { "description": "API is healthy", "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "string" } } }, "examples": { "default": { "value": { "status": "ok" } } } } } } } }
  },
  "components": {
    "schemas": {
      "CRMResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "module": { "type": "string" },
          "count": { "type": "integer" },
          "page": { "type": "integer" },
          "per_page": { "type": "integer" },
          "executionTime": { "type": "string" },
          "source": { "type": "string" },
          "data": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
        }
      },
      "CRMErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "module": { "type": "string" },
          "status": { "type": "integer" },
          "error": { "type": "string" },
          "invalidFields": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}


    "/leads": {
      "get": {
        "operationId": "getLeads",
        "summary": "Get Leads",
        "description": "Retrieve Lead records. Uses query parameters for pagination, selection and filtering.",
        "tags": ["CRM"],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 }, "description": "Page number" },
          { "name": "per_page", "in": "query", "schema": { "type": "integer", "minimum": 1 }, "description": "Records per page" },
          { "name": "ids", "in": "query", "schema": { "type": "string" }, "description": "Comma-separated list of record ids" },
          { "name": "fields", "in": "query", "schema": { "type": "string" }, "description": "Comma-separated list of fields to return" },
          { "name": "filters", "in": "query", "schema": { "type": "string" }, "description": "Zoho criteria string" }
        ],
