{
  "swagger": "2.0",
  "info": {
    "title": "F-Grade Zoho CRM API",
    "version": "1.0.0",
    "description": "Single read-only CRM query endpoint optimized for Microsoft Copilot Studio. Use GET /api/crm/query with query parameters to fetch records from Zoho CRM modules.",
    "license": {
      "name": "ISC",
      "url": "https://spdx.org/licenses/ISC.html"
    }
  },
  "security": [],
  "host": "f-grade-backend.onrender.com",
  "basePath": "/",
  "schemes": ["https"],
  "produces": ["application/json"],
  "paths": {
    "/api/crm/query": {
      "get": {
        "operationId": "queryZohoCRM",
        "tags": ["CRM"],
        "summary": "Query Zoho CRM modules (read-only)",
        "description": "Read-only query endpoint for Zoho CRM modules. Module is required. Use retrieval_mode=count for count questions, retrieval_mode=all for complete datasets, and retrieval_mode=page for paginated requests.",
        "parameters": [
          {
            "name": "module",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "Canonical or natural-language module name. Examples: Leads, Contacts, Accounts, Deals."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "description": "Optional page number for paginated requests."
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "description": "Optional records per page for paginated requests."
          },
          {
            "name": "retrieval_mode",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": ["auto", "page", "all", "count"],
            "default": "auto",
            "description": "Controls CRM record retrieval. Use 'count' for how many, total, count, or number of records. Use 'all' for the complete matching dataset. Use 'page' for limited or paginated requests such as first 30, next 30, or page 2. Use 'auto' otherwise."
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "Optional comma-separated field API names to include in each record."
          },
          {
            "name": "filters",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "Optional Zoho CRM criteria string for server-side filtering."
          },
          {
            "name": "ids",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "Optional comma-separated list of CRM record ids to fetch."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful CRM response",
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean"
                },
                "module": {
                  "type": "string"
                },
                "count": {
                  "type": "integer",
                  "format": "int32"
                },
                "page": {
                  "type": "integer",
                  "format": "int32"
                },
                "per_page": {
                  "type": "integer",
                  "format": "int32"
                },
                "executionTime": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean"
                },
                "error": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid OAuth token",
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean"
                },
                "error": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Server error or Zoho API error",
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean"
                },
                "error": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
